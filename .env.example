# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Application Environment
APP_ENV=development
LOG_LEVEL=INFO

# AI Service Settings
AI_TIMEOUT_SECONDS=30.0
AI_MAX_RETRIES=2

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=15

# Server Configuration
HOST=0.0.0.0
PORT=8000

